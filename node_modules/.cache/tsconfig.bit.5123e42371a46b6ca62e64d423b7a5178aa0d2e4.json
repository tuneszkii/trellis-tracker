{
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "node"
    ],
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "target": "es2020",
    "lib": [
      "esnext",
      "dom",
      "dom.Iterable"
    ],
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../.."
  },
  "exclude": [
    "../../trellis/trellis-platform/artifacts",
    "../../trellis/trellis-service/artifacts",
    "../../trellis/trellis-platform/public",
    "../../trellis/trellis-service/public",
    "../../trellis/trellis-platform/dist",
    "../../trellis/trellis-service/dist",
    "../../trellis/trellis-platform/node_modules",
    "../../trellis/trellis-service/node_modules",
    "../../trellis/trellis-platform/package.json",
    "../../trellis/trellis-service/package.json",
    "../../trellis/trellis-platform/./dist",
    "../../trellis/trellis-service/./dist"
  ],
  "include": [
    "../../trellis/trellis-platform/**/*",
    "../../trellis/trellis-service/**/*",
    "../../trellis/trellis-platform/**/*.json",
    "../../trellis/trellis-service/**/*.json",
    "../../trellis/trellis-platform/.mocharc.js",
    "../../trellis/trellis-service/.mocharc.js",
    "../../trellis/trellis-platform/.mocharc.cjs",
    "../../trellis/trellis-service/.mocharc.cjs",
    "./global-types/**/*"
  ]
}