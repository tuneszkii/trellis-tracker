{
	/**
	 * standardize your component dependencies.
	 * @see https://bit.dev/docs/react-env/dependencies
	 **/
	"policy": {
		/**
		 * peer dependencies for components using that env.
		 */
		"peers": [
			{
				"name": "react",
				/* the version to be installed and used by the env */
				"version": "19.2.4",
				/* the range of versions this env's components are compatible with */
				"supportedRange": "^17.0.0 || ^18.0.0 || ^19.0.0"
			},
			{
				"name": "react-dom",
				/* the version to be installed and used by the env */
				"version": "19.2.4",
				/* the range of versions this env's components are compatible with */
				"supportedRange": "^17.0.0 || ^18.0.0 || ^19.0.0"
			},
			{
				"name": "@types/react",
				"version": "19.2.14",
				"supportedRange": "^19.0.2",
				"workspaceSingleton": true
			},
			{
				"name": "@types/react-dom",
				"version": "19.2.3",
				"supportedRange": "^19.0.2",
				"workspaceSingleton": true
			},
			{
				"name": "vite",
				"version": "^8.0.0",
				"supportedRange": "^8.0.0"
			},
			{
				"name": "vitest",
				"version": "^4.1.0",
				"supportedRange": "^4.1.0"
			},
			{
				"name": "@vitest/coverage-istanbul",
				"version": "^4.1.0",
				"supportedRange": "^4.1.0"
			},
			{
				"name": "graphql",
				"version": "^16.13.1",
				"supportedRange": "^16.13.1"
			},
			{
				"name": "@mdx-js/react",
				"version": "3.1.1",
				"supportedRange": "^3.1.1",
				"workspaceSingleton": true,
        "overrides": true
			},
			{
				"name": "@mdx-js/mdx",
				"version": "3.1.1",
				"supportedRange": "^3.1.0"
			},
			{
				"name": "@teambit/mdx.ui.mdx-scope-context",
				"version": "1.1.1",
				"supportedRange": "^1.1.1"
			},
			{
				"name": "@babel/core",
				"version": "7.29.0",
				"supportedRange": "~7.29.0"
			},
			{
				"name": "@types/node",
				"version": "22.13.14",
				"supportedRange": "^22.13.14",
				"workspaceSingleton": true
			},
			{
				"name": "@types/find-root",
				"version": "^1.1.4",
				"supportedRange": "^1.1.4",
				"workspaceSingleton": true
			},
			{
        "name": "@rspack/core",
        "version": "^1.7.9",
        "supportedRange": "^1.7.9"
      },
			{
				"name": "@rspack/dev-server",
				"version": "^1.2.1",
				"supportedRange": "~1.2.1"
			},
			{
				"name": "@rspack/plugin-react-refresh",
				"version": "^1.6.1",
				"supportedRange": "~1.6.1"
			},
			{
        "name": "oxlint",
        "version": "1.55.0",
        "supportedRange": "^1.0.0"
      },
      {
        "name": "oxlint-tsgolint",
        "version": "0.17.0",
        "supportedRange": "^0.17.0"
      }
		],
		/**
		 * dev dependencies for components using that env
		 */
		"dev": []
	},

	/**
	 * associate files with a specific dev service.
	 * associated files are considered as dev files.
	 * @see https://bit.dev/docs/react-env/dependencies#configure-files-as-dev-files
	 **/
	"patterns": {
		/**
		 * files to be loaded and displayed in the 'preview' tab.
		 * @see https://bit.dev/docs/react-env/component-previews
		 */
		"compositions": ["**/*.composition.*", "**/*.preview.*", "**/*.compositions.*"],
		/**
		 * files to be loaded and displayed in the 'overview' tab.
		 * @see https://bit.dev/docs/react-env/component-docs
		 */
		"docs": ["**/*.docs.*"],
		/* files to be included in the component testing */
		"tests": ["**/*.spec.*", "**/*.test.*", "!**/__snapshots__/**/*"],
		/* other dev files */
		"dev": ["**/*.fixture.*", "**/*.fixtures.*", "**/__snapshots__/**/*"]
	}
}
