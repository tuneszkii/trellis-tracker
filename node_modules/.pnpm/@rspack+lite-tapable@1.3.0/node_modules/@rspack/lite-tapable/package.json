{
  "name": "@rspack/lite-tapable",
  "version": "1.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstackjs/rspack-lite-tapable"
  },
  "license": "MIT",
  "description": "Lite weight tapable for Rspack",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@rspack/core": "^2.2.4",
    "@types/node": "^24.13.4",
    "rstack": "^0.7.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rs lib",
    "bump": "pnpm version -m \"release: v%s\"",
    "check": "rs check",
    "dev": "rs lib -w",
    "format": "rs fmt",
    "lint": "rs lint",
    "test": "rs test",
    "test:types": "tsc -p test/types/tsconfig.json"
  }
}